{
  "name": "club-penguin-isla",
  "displayName": "Club Penguin Isla (fan theme)",
  "description": "Tema de colores inspirado en Club Penguin con un pingüino y un puffle que caminan por VS Code mientras programas.",
  "version": "1.0.0",
  "publisher": "pinguino-fan",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mistudiostudy-sys/obsidian-releases"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "club penguin",
    "penguin",
    "puffle",
    "pet",
    "theme"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Club Penguin Isla",
        "uiTheme": "vs-dark",
        "path": "./themes/club-penguin-isla-color-theme.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "clubPenguin.pet",
          "name": "🐧 Club Penguin"
        }
      ]
    },
    "commands": [
      {
        "command": "clubPenguin.show",
        "title": "Mostrar pingüino",
        "category": "Club Penguin"
      },
      {
        "command": "clubPenguin.customize",
        "title": "Personalizar pingüino",
        "category": "Club Penguin",
        "icon": "$(paintcan)"
      },
      {
        "command": "clubPenguin.applyTheme",
        "title": "Activar tema de colores",
        "category": "Club Penguin"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "clubPenguin.customize",
          "when": "view == clubPenguin.pet",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Club Penguin",
      "properties": {
        "clubPenguin.name": {
          "type": "string",
          "default": "Pingüi",
          "description": "Nombre de tu pingüino (aparece en sus globos de texto)."
        },
        "clubPenguin.color": {
          "type": "string",
          "default": "azul",
          "description": "Color del pingüino: azul, rojo, verde, rosa, negro, morado, naranja, amarillo, verde-oscuro, azul-claro, cafe, durazno, aqua, lima, o un color hex como #ff00aa."
        },
        "clubPenguin.hat": {
          "type": "string",
          "default": "gorra-helice",
          "enum": ["ninguno", "gorra-helice", "fiesta", "corona", "vikingo", "gorro-lana", "bruja", "copa"],
          "description": "Sombrero del pingüino."
        },
        "clubPenguin.accessory": {
          "type": "string",
          "default": "bufanda",
          "enum": ["ninguno", "bufanda", "corbatin", "lentes", "audifonos"],
          "description": "Accesorio del pingüino."
        },
        "clubPenguin.puffleColor": {
          "type": "string",
          "default": "rosa",
          "enum": ["azul", "rosa", "negro", "verde", "morado", "rojo", "amarillo", "blanco", "naranja", "cafe", "dorado"],
          "description": "Color de tu puffle."
        },
        "clubPenguin.showPuffle": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar al puffle siguiendo a tu pingüino."
        },
        "clubPenguin.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 3,
          "description": "Velocidad al caminar (1 = normal)."
        },
        "clubPenguin.messages": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "¡Waddle on! 🐧",
            "¡Sigue programando, vas increíble!",
            "¿Ya hiciste commit? 👀",
            "¡Mi puffle cree en ti! 💖",
            "Un bug menos = 100 monedas 🪙",
            "¿Una partida de Card-Jitsu después de esto?",
            "Nos vemos en la Disco 🕺",
            "¡Toma agua! Hasta los pingüinos se hidratan 💧",
            "Ese código está más limpio que la nieve ❄️",
            "Respira… y vuelve a leer el error 😌",
            "¡Fiesta de igloo cuando termines! 🎉"
          ],
          "description": "Frases que dice tu pingüino al hacerle click."
        }
      }
    }
  }
}
